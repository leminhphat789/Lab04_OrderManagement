      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "auth_url",
      "value": "http://127.0.0.1:5001"
    },
    {
      "key": "products_url",
      "value": "http://127.0.0.1:5002"
    },
    {
      "key": "orders_url",
      "value": "http://127.0.0.1:5003"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "order_id",
      "value": ""
    },
    {
      "key": "item_id",
      "value": ""
    },
    {
      "key": "extra_item_id",
      "value": ""
    },
    {
      "key": "product1_id",
      "value": ""
    },
    {
      "key": "product2_id",
      "value": ""
    },
    {
      "key": "product3_id",
      "value": ""
