      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "const d = pm.response.json(); pm.collectionVariables.set(\"order_id\", d.id); pm.collectionVariables.set(\"item_id\", d.items[0].id); pm.test(\"Tong tien\", () => pm.expect(d.total_amount).to.eql(\"500000.00\"));"
            ]
          }
        }
